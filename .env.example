# ─── Contact form: Gmail API (OAuth2) ──────────────────────────
# The contact form at /connect sends email via the Gmail API.
# Until these are set, the form returns a 503 and logs the message server-side.
#
# How to obtain these:
# 1. Google Cloud Console → create a project → enable the "Gmail API".
# 2. Create OAuth 2.0 Client ID credentials (type: Web application or Desktop).
# 3. Use the OAuth Playground (https://developers.google.com/oauthplayground)
#    with scope: https://www.googleapis.com/auth/gmail.send
#    → authorise with the GMAIL_SENDER account → exchange for a refresh token.
# 4. Fill in the values below. Never commit the real .env file.

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# The Gmail account that owns the OAuth credentials and sends the mail.
GMAIL_SENDER=s19003045@gmail.com

# Where contact-form submissions are delivered.
CONTACT_RECIPIENT=s19003045@gmail.com

# ─── Anti-spam ─────────────────────────────────────────────────
# Secret used to sign the contact form's timing token (HMAC).
# Generate a random value, e.g.:  openssl rand -hex 32
CONTACT_TOKEN_SECRET=
