# Copy this file to `.env` and adjust. `.env` is git-ignored.

# ─── Docker Compose ────────────────────────────────────────────
# Host port(s) published for the web service → container port 3000.
# docker-compose.yml reads this as "${WEB_PORTS}:3000".
# Use a range to scale (one host port per replica):
#   docker compose up -d --scale web=3
WEB_PORTS=3051-3053

# ─── Contact form: Gmail API (OAuth2) ──────────────────────────
# The contact form at /connect sends email via the Gmail API.
# Until these are set, the form returns a 503 and logs the message server-side.
#
# How to obtain these:
# 1. Google Cloud Console → create a project → enable the "Gmail API".
# 2. Create OAuth 2.0 Client ID credentials (type: Web application or Desktop).
# 3. Use the OAuth Playground (https://developers.google.com/oauthplayground)
#    with scope: https://www.googleapis.com/auth/gmail.send
#    → authorise with the GMAIL_SENDER account → exchange for a refresh token.
# 4. Fill in the values below. Never commit the real .env file.

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# The Gmail account that owns the OAuth credentials and sends the mail.
GMAIL_SENDER=s19003045@gmail.com

# Where contact-form submissions are delivered.
CONTACT_RECIPIENT=s19003045@gmail.com

# ─── Anti-spam ─────────────────────────────────────────────────
# Secret used to sign the contact form's timing token (HMAC).
# Generate a random value, e.g.:  openssl rand -hex 32
CONTACT_TOKEN_SECRET=

# ─── Analytics: Google Analytics 4 ─────────────────────────────
# GA4 Measurement ID (looks like G-XXXXXXXXXX).
# Get it from Google Analytics → Admin → Data Streams → your web stream.
# When unset, no analytics script loads and the consent banner stays hidden.
# NEXT_PUBLIC_ prefix is required so the value reaches the browser; it is
# baked in at build time, so rebuild after changing it.
# Remember to enable "Enhanced Measurement" in GA so client-side route
# changes are tracked as pageviews.
NEXT_PUBLIC_GA_ID=

# ─── Content Scheduling ───────────────────────────────────────
# Future-dated blog posts are shown automatically in development
# and hidden automatically in production.
# Override that behavior explicitly when needed:
#   SHOW_FUTURE_POSTS=true   -> always show future-dated posts
#   SHOW_FUTURE_POSTS=false  -> always hide future-dated posts
SHOW_FUTURE_POSTS=
